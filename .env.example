DRMS_STORAGE=mysql
DRMS_DB_HOST=127.0.0.1
DRMS_DB_PORT=3306
DRMS_DB_NAME=dental_clinic
DRMS_DB_USER=dental_app
DRMS_DB_PASSWORD=replace-with-a-strong-database-password
DRMS_DB_AUTO_INIT=1

# Required before allowing doctor/staff account registration.
DRMS_STAFF_CODE=replace-with-a-long-random-staff-code

# Use 1 only when the site is served over HTTPS.
DRMS_COOKIE_SECURE=0

# Optional TLS certificate authority path for a remote MySQL server.
DRMS_DB_SSL_CA=
